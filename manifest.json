{
  "manifest_version": 3,
  "name": "Just Monika",
  "version": "1.0",
  "description": "Just Monika",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Aller_Rg.woff", "RifficFree-Bold.woff", "style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
